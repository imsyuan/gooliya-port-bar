{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gooliya Port Bar",
  "version": "0.3.0",
  "identifier": "com.gooliya.portbar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gooliya Port Bar",
        "width": 360,
        "height": 520,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEMTQxMjgzRTNCNjc1RkUKUldUK2RiYmpneElVclQ5aFk2SDFaYm1XcUJ6T2cyek1obEdmNlhJZ3FvUXBUblVzQ2tQdWZVMG0K",
      "endpoints": [
        "https://github.com/imsyuan/gooliya-port-bar/releases/latest/download/latest.json"
      ]
    }
  }
}
